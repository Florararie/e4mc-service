[TEMPLATE]
# One file for both services; installed to /etc/e4mc/e4mc.env by install.sh.
# The tunnel writes the link to STATE_DIR; the watcher reads it from there.

# -- tunnel -----------------------------------------------------------------
MC_HOST=127.0.0.1
MC_PORT=25565

# Leave BROKER_URL alone to let e4mc pick the nearest relay, or pin one:
# RELAY_HOST=na.e4mc.link
# RELAY_PORT=25575
BROKER_URL=https://broker.e4mc.link/getBestRelay

# The relay currently assigns *.na.e4mc.link; this suffix covers it.
DOMAIN_SUFFIX=.e4mc.link
KEEPALIVE_INTERVAL=15
IDLE_TIMEOUT=30
RECONNECT_MIN=1
RECONNECT_MAX=30
# How often the tunnel refreshes state.json while connected.
HEARTBEAT_INTERVAL=20
LOG_LEVEL=INFO

# Both services must agree on this path.
STATE_DIR=/var/lib/e4mc

# -- watcher ----------------------------------------------------------------
# The two destinations below are independent: set either one, both, or neither.
# With neither set the watcher only logs link changes and nothing leaves the
# machine, so a tunnel-only install is just e4mc-tunnel.service.

# 1. A landing page on GitHub Pages.
#    A fine-grained token with "Contents: Read and write" on PAGES_REPO.
#    Leave both values empty to skip publishing a page.
GITHUB_TOKEN=
# The repository as owner/name; not fixed in the code.
PAGES_REPO=
PAGES_BRANCH=main
PAGES_PATH=index.html
# Author of the page commit. GitHub's web/API identity by default, so the
# history names GitHub rather than your account; any "Name <email>" works.
PAGES_COMMIT_AUTHOR="GitHub <noreply@github.com>"
PAGES_COMMIT_MESSAGE="Update the Minecraft address on the page"

# 2. A Discord channel announcement for every new address.
#    Channel settings -> Integrations -> Webhooks -> Copy Webhook URL.
#    Empty means the watcher never attempts a post.
DISCORD_WEBHOOK_URL=

POLL_INTERVAL=5
# Ignore a link whose heartbeat is older than this many seconds (the page then
# marks it offline instead of live).
STATE_MAX_AGE=90
# GitHub account credited in the page footer.
PAGE_AUTHOR=Florararie
